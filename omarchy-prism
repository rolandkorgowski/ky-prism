#!/usr/bin/env bash
set -Eeuo pipefail
export OMP_NUM_THREADS=4
# Process-local PRIME settings. The shared RTX routing script is never edited.
# GTK 4 draws through EGL: natively on Wayland, or on X11/XWayland.
mode=${PRISM_GPU:-auto}
case $mode in
 auto)
  if [[ -d /proc/driver/nvidia/gpus ]]; then
   export __NV_PRIME_RENDER_OFFLOAD=1
   export __GLX_VENDOR_LIBRARY_NAME=nvidia
  fi ;;
 nvidia)
  export __NV_PRIME_RENDER_OFFLOAD=1
  export __GLX_VENDOR_LIBRARY_NAME=nvidia ;;
 system) ;;
 *) printf '%s\n' 'PRISM_GPU: auto, nvidia albo system.' >&2; exit 1 ;;
esac
# PRISM_BACKEND=x11 keeps the earlier XWayland route (needs DISPLAY);
# the default lets GTK choose, which is native Wayland in a Wayland session.
case ${PRISM_BACKEND:-auto} in
 auto) ;;
 wayland) export GDK_BACKEND=wayland ;;
 x11)
  [[ -n ${DISPLAY:-} ]] || { printf '%s\n' 'PRISM_BACKEND=x11 wymaga X11/XWayland (DISPLAY).' >&2; exit 1; }
  export GDK_BACKEND=x11 ;;
 *) printf '%s\n' 'PRISM_BACKEND: auto, wayland albo x11.' >&2; exit 1 ;;
esac
exec "${XDG_DATA_HOME:-$HOME/.local/share}/omarchy-prism/bin/ky-prism" "$@"
