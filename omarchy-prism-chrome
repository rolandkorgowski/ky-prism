#!/usr/bin/env python3
"""Launch the installed Google Chrome, without a shell or changed GPU routing."""
import shutil
import subprocess
import sys
browser = next((path for name in ('google-chrome-stable', 'google-chrome')
                if (path := shutil.which(name))), None)
if not browser:
    sys.exit('Nie znaleziono Google Chrome. Zainstaluj przeglądarkę, aby użyć skrótu.')
args = [browser, '--new-window']
if shutil.which('uwsm-app'):
    args = ['uwsm-app', '-t', 'service', '--', *args]
subprocess.Popen(args, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                 stderr=subprocess.DEVNULL, start_new_session=True, close_fds=True)
