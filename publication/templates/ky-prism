#!/usr/bin/env bash
set -Eeuo pipefail
prefix=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
export OMP_NUM_THREADS=${OMP_NUM_THREADS:-4}
export PRISM_JPEG_BACKEND=${PRISM_JPEG_BACKEND:-auto}
# GTK 4 draws through EGL, natively on Wayland or on X11/XWayland. The PRIME
# variables are process-local and harmless on a single-GPU system.
case ${PRISM_GPU:-auto} in
  auto)
    if [[ -d /proc/driver/nvidia/gpus ]]; then
      export __NV_PRIME_RENDER_OFFLOAD=1 __GLX_VENDOR_LIBRARY_NAME=nvidia
    fi ;;
  nvidia)
    export __NV_PRIME_RENDER_OFFLOAD=1 __GLX_VENDOR_LIBRARY_NAME=nvidia ;;
  system) ;;
  *) printf '%s\n' 'PRISM_GPU must be auto, nvidia or system.' >&2; exit 1 ;;
esac
case ${PRISM_BACKEND:-auto} in
  auto) ;;
  wayland) export GDK_BACKEND=wayland ;;
  x11)
    [[ -n ${DISPLAY:-} ]] || { printf '%s\n' 'PRISM_BACKEND=x11 requires X11/XWayland (DISPLAY).' >&2; exit 1; }
    export GDK_BACKEND=x11 ;;
  *) printf '%s\n' 'PRISM_BACKEND must be auto, wayland or x11.' >&2; exit 1 ;;
esac
exec "$prefix/libexec/ky-prism/ky-prism" "$@"
