#!/usr/bin/env python3
"""Detach the viewer from the short-lived shell widget process."""
import os
from pathlib import Path
import shutil
import subprocess
import sys
launcher = Path.home() / '.local/bin/ky-prism'
if not os.access(launcher, os.X_OK):
    sys.exit('Brak przeglądarki ky-prism; uruchom ./run.sh photos install')
args = [str(launcher)]
if shutil.which('uwsm-app'):
    args = ['uwsm-app', '-t', 'service', '--', *args]
subprocess.Popen(args, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                 stderr=subprocess.DEVNULL, start_new_session=True, close_fds=True)
