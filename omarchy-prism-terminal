#!/usr/bin/env python3
"""Launch Alacritty in its own service without changing the user's GPU environment."""
import shutil
import subprocess
import sys
terminal = shutil.which('alacritty')
if not terminal:
    sys.exit('Nie znaleziono Alacritty.')
args = [terminal]
if shutil.which('uwsm-app'):
    args = ['uwsm-app', '-t', 'service', '--', *args]
subprocess.Popen(args, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                 stderr=subprocess.DEVNULL, start_new_session=True, close_fds=True)
